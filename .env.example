# --- Supabase -----------------------------------------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side ONLY, never prefix with NEXT_PUBLIC_.
# Used only in trusted server routes (e.g. background processing).
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ---------------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it
# to every visitor's browser. All Gemini calls happen in lib/gemini.ts,
# which only ever runs on the server (API routes / server components).
GEMINI_API_KEY=

# --- App --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
